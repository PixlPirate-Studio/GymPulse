<?xml version="1.0"?>
<Container version="2">
  <Name>GymPulse</Name>
  <Repository>ghcr.io/thepixlpirate/gympulse:latest</Repository>
  <Registry>https://github.com/thepixlpirate/gympulse/pkgs/container/gympulse</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/thepixlpirate/gympulse</Support>
  <Overview>Self-hosted workout timer, food diary, body stats and friends tracker. Installs on an iPhone as a web app.</Overview>
  <Category>Other:</Category>
  <WebUI>http://[IP]:[PORT:8765]/</WebUI>
  <Icon>https://raw.githubusercontent.com/thepixlpirate/gympulse/main/static/icons/icon-192.png</Icon>
  <Config Name="Web port" Target="8080" Default="8765" Mode="tcp" Description="Port for the web page" Type="Port" Display="always" Required="true">8765</Config>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/gympulse" Mode="rw" Description="Database, keys and backups" Type="Path" Display="always" Required="true">/mnt/user/appdata/gympulse</Config>
  <Config Name="Secure cookies" Target="GYMPULSE_SECURE_COOKIES" Default="1" Mode="" Description="1 when you reach it through https (Cloudflare tunnel). Use 0 for plain http on your LAN." Type="Variable" Display="always" Required="false">1</Config>
  <Config Name="Timezone" Target="TZ" Default="America/Indiana/Indianapolis" Mode="" Description="Your timezone" Type="Variable" Display="always" Required="false">America/Indiana/Indianapolis</Config>
</Container>
